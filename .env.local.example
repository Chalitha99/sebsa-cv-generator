# Supabase project credentials (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses Row Level Security. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider abstraction (see docs/05-ai-provider-abstraction.md)
# 'gemini' is the active MVP provider. 'claude' is implemented but not yet wired with a key.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# Reserved for the future Claude swap. Leave empty until AI_PROVIDER=claude.
CLAUDE_API_KEY=
